{
  "expo": {
    "name": "FitChecked",
    "slug": "fitchecked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitchecked",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tamzeedq.fitchecked"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2EFE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tamzeedq.fitchecked"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f2efe8",
          "dark": {
            "backgroundColor": "#1a1d18"
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "FitChecked uses the camera to photograph the clothes you add to your closet."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitChecked uses your photos so you can add clothes you've already photographed."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show local weather for outfit suggestions."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "FitChecked saves outfit images you choose to share to your photo library."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
